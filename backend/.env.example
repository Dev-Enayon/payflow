# ---------------------------------------------------------------------------
# PayFlow backend environment
# Copy to .env and fill in your own values. Never commit .env.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed browser origins
FRONTEND_URL=http://localhost:5173
# The URL Paystack redirects the customer to after checkout. Must match a
# route in the frontend app (the app then asks the backend to verify).
PAYSTACK_CALLBACK_URL=http://localhost:5173/payment/verify

# PostgreSQL connection string (Neon)
# Use the NEON POOLED connection string for the running app.
# Use the NEON DIRECT connection string for Prisma migrations.
DATABASE_URL=
DIRECT_URL=

# Paystack credentials (dashboard -> Settings -> API Keys & Webhooks).
# Use the LIVE secret key on the server only. Never expose it in frontend code
# or any VITE_ variable.
PAYSTACK_SECRET_KEY=
# Not required by the backend: checkout uses Paystack's hosted authorization_url.
PAYSTACK_PUBLIC_KEY=
# Paystack sends webhooks to: https://your-api-host/api/webhooks/paystack
# Locally use a tunnel (ngrok/cloudflared) and configure that URL in Paystack.

# 32+ random characters. Used for session hashing and webhook-secret encryption.
# Generate with: openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_HOURS=168
# Optional dedicated encryption key (falls back to SESSION_SECRET derivation)
ENCRYPTION_KEY=

# Optional: encrypt the session cookie domain, only for subdomain deployments
COOKIE_DOMAIN=
# Cross-site production cookies (Vercel frontend + Render API) should use
# SameSite=None. Production defaults to none and Secure automatically.
# COOKIE_SAME_SITE=none
# Express trust proxy setting (1 when behind Render/Vercel proxy)
TRUST_PROXY=1

# Local development only: simulate Paystack without credentials. Must be false
# in production. The mock checkout page lets you simulate success/failure.
PAYSTACK_MOCK=true

# Payment limits (NGN major units)
MIN_PAYMENT_AMOUNT=100
MAX_PAYMENT_AMOUNT=5000000

# Seed credentials. If omitted, the seed script generates a random password
# once and prints it to the terminal. Use strong values in development.
SEED_ADMIN_EMAIL=admin@payflow.local
SEED_ADMIN_PASSWORD=
SEED_MERCHANT_EMAIL=merchant@payflow.local
SEED_MERCHANT_PASSWORD=
BUSINESS_NAME=PayFlow
SUPPORT_EMAIL=support@payflow.local
BRAND_NAME=PayFlow

# Rate limits (requests per window). Set RATE_LIMITS_ENABLED=false only in tests.
RATE_LIMITS_ENABLED=true
LOGIN_RATE_LIMIT=10
INIT_RATE_LIMIT=10
VERIFY_RATE_LIMIT=60
