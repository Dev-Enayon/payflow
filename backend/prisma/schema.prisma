generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MERCHANT
}

enum TransactionStatus {
  INITIALIZED
  PENDING
  SUCCESS
  FAILED
  ABANDONED
  REVERSED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ApiKeyEnvironment {
  TEST
  LIVE
}

model User {
  id             String            @id @default(cuid())
  email          String            @unique
  name           String
  passwordHash   String
  role           Role              @default(MERCHANT)
  isActive       Boolean           @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  sessions       Session[]
  apiCredentials ApiCredential[]
  auditLogs      AuditLog[]
  webhookEndpoints WebhookEndpoint[]

  @@index([role])
}

model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  csrfToken  String
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  ip         String?
  userAgent  String?
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PaymentTransaction {
  id                String            @id @default(cuid())
  reference         String            @unique
  amount            Int
  currency          String            @default("NGN") @db.VarChar(3)
  customerEmail     String
  customerName      String?
  status            TransactionStatus @default(INITIALIZED)
  provider          String            @default("paystack")
  providerReference String?           @unique
  channel           String?
  gatewayResponse   String?
  failureReason     String?
  metadata          Json?
  initializedAt     DateTime          @default(now())
  verifiedAt        DateTime?
  paidAt            DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([paidAt])
  @@index([customerEmail])
}

model WebhookEvent {
  id           String             @id @default(cuid())
  payloadHash  String             @unique
  eventType    String
  reference    String?
  status       WebhookEventStatus @default(RECEIVED)
  signature    String?
  payload      Json
  attempts     Int                @default(1)
  error        String?
  processedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deliveries   WebhookDelivery[]

  @@index([reference])
  @@index([eventType])
  @@index([createdAt])
}

model WebhookEndpoint {
  id                 String                 @id @default(cuid())
  url                String
  description        String?
  events             String[]               @default([])
  secretEncrypted    String
  secretLastFour     String
  isActive           Boolean                @default(true)
  lastDeliveryAt     DateTime?
  lastDeliveryStatus WebhookDeliveryStatus?
  failureCount       Int                    @default(0)
  createdById        String?
  createdBy          User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  deliveries         WebhookDelivery[]

  @@index([isActive])
}

model WebhookDelivery {
  id             String                @id @default(cuid())
  endpointId     String
  endpoint       WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  eventId        String?
  event          WebhookEvent?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventType      String
  reference      String?
  payload        Json
  signature      String?
  status         WebhookDeliveryStatus @default(PENDING)
  responseStatus Int?
  responseBody   String?
  error          String?
  attempts       Int                   @default(1)
  durationMs     Int?
  deliveredAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([endpointId, createdAt])
  @@index([reference])
  @@index([status])
  @@index([createdAt])
}

model ApiCredential {
  id          String           @id @default(cuid())
  name        String
  keyPrefix   String
  keyHash     String           @unique
  lastFour    String
  environment ApiKeyEnvironment
  createdById String
  createdBy   User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([createdById])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail  String?
  action      String
  entityType  String?
  entityId    String?
  ip          String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model Setting {
  id              String   @id
  businessName    String
  brandName       String
  supportEmail    String
  website         String?
  defaultCurrency String   @default("NGN") @db.VarChar(3)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
