# Base URL of the PayFlow API (no trailing slash).
# Production (set in Vercel before building): https://<backend-host>/api
VITE_API_BASE_URL=http://localhost:5000/api
# Public brand name used in the UI
VITE_BRAND_NAME=PayFlow
# Public site URL used for links in metadata
VITE_SITE_URL=http://localhost:5173

# PayFlow uses Paystack's hosted checkout redirect, so a frontend Paystack
# public key is not required. Never add PAYSTACK_SECRET_KEY to any VITE_ var.
